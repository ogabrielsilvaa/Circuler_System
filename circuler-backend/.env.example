# DB_USER e DB_PASS sao consumidos tanto pelo Spring quanto pelo
# docker-compose.yml na criacao do container MySQL.
DB_URL=jdbc:mysql://localhost:3307/circuler?useTimezone=true&serverTimezone=UTC
DB_USER=seu_usuario
DB_PASS=sua_senha
MYSQL_ROOT_PASSWORD=sua_senha_root

JWT_SECRET=sua_chave_secreta_jwt_com_no_minimo_32_caracteres

# O CPF precisa ter 11 digitos e ser unico na tabela users.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=SuaSenhaAdmin@123
ADMIN_CPF=00000000000

# Credenciais em Settings > API Keys do painel do Cloudinary.
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret
